{
  "name": "tomatodevs-profile",
  "version": "2.0.0",
  "private": true,
  "description": "TomatoDevs Personal Bio, Projects Showcase & 3D Armillary Sphere — Built with Next.js & Tailwind CSS",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "r2:upload": "node scripts/upload-music-to-r2.mjs",
    "spotify:sync": "node scripts/sync-spotify-playlist.mjs",
    "breakcore:sync": "node scripts/sync-breakcore-mix.mjs",
    "redis:up": "docker compose up -d",
    "redis:down": "docker compose down",
    "redis:status": "node scripts/redis-status.mjs",
    "redis:flush": "node scripts/redis-status.mjs --flush",
    "redis:logs": "docker compose logs -f",
    "homelab:up": "bash scripts/homelab/run.sh up",
    "homelab:sync": "bash scripts/homelab/run.sh sync",
    "homelab:watch": "bash scripts/homelab/run.sh watch",
    "homelab:tunnel": "bash scripts/homelab/run.sh set-tunnel",
    "homelab:status": "bash scripts/homelab/run.sh status",
    "homelab:logs": "bash scripts/homelab/run.sh logs",
    "homelab:down": "bash scripts/homelab/run.sh down",
    "test:load": "bash scripts/load-test/run-load-test.sh",
    "test:load:quick": "node scripts/load-test/autocannon-quick.mjs",
    "test:load:smoke": "bash scripts/load-test/run-load-test.sh http://localhost:3000 smoke",
    "test:load:stress": "bash scripts/load-test/run-load-test.sh http://localhost:3000 stress"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomatoDevs/Profile.git"
  },
  "keywords": [
    "nextjs",
    "tailwindcss",
    "threejs",
    "portfolio",
    "bio",
    "tomatodevs"
  ],
  "author": "TomatoDevs",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/TomatoDevs/Profile/issues"
  },
  "homepage": "https://github.com/TomatoDevs/Profile#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@upstash/redis": "^1.38.2",
    "next": "^15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.128.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
