# ============================================================================
# REDIS CONFIGURATION (Docker Local Redis / Upstash Cloud Redis)
# 1. Local Docker (Run `npm run redis:up` or `docker compose up -d`):
#    Uses local Redis 7 + Serverless Redis HTTP proxy on port 8079.
# 2. Cloud Production (Vercel / Upstash):
#    Replace with your Upstash REST URL & Token from https://console.upstash.com/
# ============================================================================
REDIS_URL="redis://127.0.0.1:6379"
UPSTASH_REDIS_REST_URL="http://127.0.0.1:8079"
UPSTASH_REDIS_REST_TOKEN="tomato_local_redis_secret_token"

# ============================================================================
# SECURITY & OPTIONAL CONFIGURATION
# ============================================================================
# Optional: Restrict CORS origin for API routes (defaults to same-origin or *)
ALLOWED_ORIGIN="https://tomatodevs.com"

# Optional: Secret token used by Vercel Cron to authenticate scheduled refreshes
CRON_SECRET="your-optional-cron-secret"

# Optional: Override TikTok username to scrape stats for (default: tomatodevs)
TIKTOK_USERNAME="tomatodevs"

# ============================================================================
# CLOUDFLARE R2 STORAGE (S3-compatible Object Storage for Media & Audio)
# Obtain from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
# ============================================================================
# Cloudflare Account ID (Found in Cloudflare Dashboard URL or right sidebar)
R2_ACCOUNT_ID="your_cloudflare_account_id"

# R2 API Token Access Key ID & Secret Access Key
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"

# R2 Bucket Name (e.g. tomatodevs-media)
R2_BUCKET_NAME="tomatodevs-media"

# Public Access URL (R2.dev subdomain or custom domain like https://media.tomatodevs.com)
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

